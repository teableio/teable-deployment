# Server entrypoint: TLS termination + routing (imports shared caddy.snippets).
# Template: apply.sh renders it to *.generated -- the TLS_GLOBAL placeholder line becomes the ACME global block or nothing,
# the per-site TLS_SITE placeholder becomes the Cloudflare DNS-01 `tls { ... }` block (cloudflare mode) or `tls /certs/...`
# (static mode, your own certificate), and the APP_CUSTOM_DOMAINS placeholder line becomes one site per app custom domain.
# Wildcard certificates (*.app / *.sandbox) require DNS-01 or a certificate you bring; the caddy-data volume must persist (stores certs, avoids re-issue rate limits).
__TLS_GLOBAL__

import caddy.snippets

# Console + Infra API + git smart-http + object storage + sandbox port-preview rewrite.
# One host, one certificate: /git and the bucket path-prefixes ride the Infra domain,
# so the deployment needs no dedicated git./s3. DNS records.
{$INFRA_HOST} {
	__TLS_SITE__
	handle /git/* {
		reverse_proxy git-registry:8080
	}
	# Bare /<bucket> (no trailing slash) must match too: minio-js getBucketRegion sends GET /<bucket>?location,
	# and Caddy's /x/* does not cover /x -- without it the request falls through to the console and the client
	# chokes on HTML where it expects S3 XML.
	@minio path /{$S3_BUCKET} /{$S3_BUCKET}/* /{$TEABLE_PUBLIC_BUCKET} /{$TEABLE_PUBLIC_BUCKET}/* /{$TEABLE_PRIVATE_BUCKET} /{$TEABLE_PRIVATE_BUCKET}/* /minio/health/*
	handle @minio {
		reverse_proxy minio:9000
	}
	import infra_and_v1
}

# App previews
*.app.{$BASE_DOMAIN} {
	__TLS_SITE__
	reverse_proxy infra-service:8080
}

# App custom domains (APP_CUSTOM_DOMAINS in .env): infra-service maps each domain to its app by Host.
__APP_CUSTOM_DOMAINS__

# Sandbox previews (independent origin at root path)
*.sandbox.{$BASE_DOMAIN} {
	__TLS_SITE__
	import sandbox_preview
}

