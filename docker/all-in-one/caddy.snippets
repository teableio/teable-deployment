# Shared routes -- imported by both the local and server Caddyfiles; the sandbox preview rewrite lives only here.
# {$SANDBOX_PREVIEW_HOST} is injected by compose per mode and substituted at parse time.

# Console + Infra API + sandbox port-preview rewrite.
#   Port preview (/v1/sandboxes/{id}/endpoints/{port}) returns host:port/proxy/{port} by default, which 404s root-path assets of Next/SPA apps;
#   rewrite it here to the root-path subdomain {id}-{port}.{$SANDBOX_PREVIEW_HOST} (no scheme; consumers add their own), and hand proxying to (sandbox_preview).
(infra_and_v1) {
	# use_server_proxy=true asks the engine for a path-proxied endpoint (no wildcard
	# DNS needed) -- let those requests through; only rewrite the default form.
	@endpoints {
		path_regexp ep ^/v1/sandboxes/([a-z0-9-]+)/endpoints/([0-9]+)/?$
		not query use_server_proxy=true
	}
	handle @endpoints {
		header Content-Type application/json
		respond `{"endpoint":"{re.ep.1}-{re.ep.2}.{$SANDBOX_PREVIEW_HOST}"}` 200
	}
	# Sandbox engine API (auth header passed through)
	handle /v1/* {
		reverse_proxy opensandbox-server:8090
	}
	# Console/Infra API; app previews also go here (infra's built-in gateway matches by Host)
	handle {
		reverse_proxy infra-service:8080
	}
}

# Sandbox previews (independent origin at root path): Host={id}-{port}.sandbox.<domain> -> the sandbox container itself.
#   Caddy sits on the sandbox network (compose: teable-sandbox-net) and dials container sandbox-{id} by Docker DNS, the role
#   the ingress gateway plays on Kubernetes. No engine hop in between, so request and response headers (Cookie,
#   Authorization), WebSocket and compression pass through untouched; the engine's /v1/sandboxes/{id}/proxy/{port} path
#   proxy stays a machine-only API (key required) and never carries browser traffic.
#   The upstream address holds placeholders, which Caddy treats as one "dynamically static" upstream: keep health checks
#   and load balancing at their defaults (off) here, otherwise one dead sandbox would mark every preview down.
#   Sandboxes created with a networkPolicy share an egress sidecar's namespace on the default bridge and are not reachable
#   this way; Teable never requests one.
(sandbox_preview) {
	@sbx header_regexp sbx Host ^([a-z0-9-]+)-([0-9]+)\.
	handle @sbx {
		reverse_proxy sandbox-{re.sbx.1}:{re.sbx.2}
	}
	# Catch-all: Host does not match the {id}-{port} shape (should not happen normally)
	handle {
		respond 404
	}
}
