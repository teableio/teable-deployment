# ============================================================================
# Teable server deployment config -- the only file you need to edit.
#   cp .env.server.example .env
#   Edit the "required" entries below; apply.sh auto-fills/derives blank secrets and addresses
#   ./apply.sh server && docker compose up -d      (add --with-app for all-in-one)
# There is a single domain concept: BASE_DOMAIN -- typically a subdomain of your
# organization's domain (e.g. teable.example.com). All entries split off it:
#   main site = <BASE_DOMAIN>; console/API/git/storage = infra.<BASE_DOMAIN> (path-routed);
#   app previews = *.app.<BASE_DOMAIN>; sandbox previews = *.sandbox.<BASE_DOMAIN>.
# The named parts are conventions, not requirements: the site/console hosts can be moved to
# any domain via the "Advanced" section at the end of this file; the *.app./*.sandbox.
# wildcards are derived from BASE_DOMAIN and not separately configurable in this version.
# ============================================================================

# === Compose ===
# apply.sh fixes this line and adds docker-compose.override.yml (git keys); afterwards plain docker compose up -d works.
COMPOSE_FILE=compose.yaml:compose.server.yaml
# Derived by apply.sh (TLS option -> mode/image; file fingerprints so that `docker compose up -d` recreates the
# containers that load a replaced certificate/CA/engine config at start); do not edit.
TLS_MODE=
CADDY_IMAGE=
TLS_CERT_SHA256=
PRIVATE_CA_SHA256=
OPENSANDBOX_CONFIG_SHA256=

# === Domain and TLS (required; the only lines that need thought) ===
# DNS setup (required, done by you): create four DNS A/AAAA records pointing at this machine:
#   <BASE_DOMAIN>, infra.<BASE_DOMAIN>, *.app.<BASE_DOMAIN>, *.sandbox.<BASE_DOMAIN>
#   on a DNS server that BOTH your users' machines and this machine use (a public zone, or your internal DNS;
#   an /etc/hosts entry cannot express the two wildcards, and containers do not read the host's hosts file).
#   With Cloudflare: DNS-only / no proxy. The token below only answers DNS-01 challenges; it does not create these records.
# Deployment root domain: all services split off it (see file header).
BASE_DOMAIN=teable.example.com

# --- TLS: fill in ONE of the two options; apply.sh derives TLS_MODE from what is filled ---
# Option A -- automatic certificates: Let's Encrypt via Cloudflare DNS-01. Works on intranet machines too
#   (the challenge is a DNS record; the machine never needs to be reachable from the internet).
# Let's Encrypt account email.
ACME_EMAIL=you@example.com
# Cloudflare API token; needs Zone:Read + DNS:Edit (used for DNS-01 wildcard certificate issuance).
CLOUDFLARE_API_TOKEN=
# Option B -- your own certificate: private networks, corporate PKI, no DNS API. Absolute host paths, PEM.
#   ONE certificate must cover all four names: <BASE_DOMAIN>, infra.<BASE_DOMAIN>, *.app.<BASE_DOMAIN>,
#   *.sandbox.<BASE_DOMAIN> (apply.sh warns about missing names). TLS_CERT_FILE = the full chain.
#   After replacing the files on disk: ./apply.sh server [--with-app] then docker compose up -d (recreates caddy).
#   Signed by a private/corporate CA? Also set PRIVATE_CA_FILE (Advanced section). Guide: private-network.md.
TLS_CERT_FILE=
TLS_KEY_FILE=

# === Secrets (leave blank; apply.sh generates random values) ===
# One key shared by the whole stack (engine / Infra API / console login / git internal).
OPENSANDBOX_API_KEY=
# Console session signing secret.
SESSION_SECRET=
# MinIO root user / password (= artifact-store S3 access / secret keys).
S3_ACCESS_KEY=
S3_SECRET_KEY=

# === Images ===
# First-party images: this file is the single source of tags. All default images are publicly pullable; docker login ghcr.io only if you substitute private ones.
# Infra Service / Git Registry image (one image serves both).
INFRA_SERVICE_IMAGE=ghcr.io/teableio/teable-infra-service:latest
# Sandbox engine (OpenSandbox server).
OPENSANDBOX_SERVER_IMAGE=ghcr.io/teableio/opensandbox-server:v0.2.0-fix9
# Sandbox agent image PREFIX -- no tag. Teable launches AI sessions with
# <prefix>:<its own release tag>, so the agent always matches the app version,
# and it preheats that image through the Infra API on startup.
# China deployments: use the Aliyun mirror prefix instead:
#   registry.cn-shenzhen.aliyuncs.com/teable/teable-sandbox-agent
SANDBOX_OPENSANDBOX_IMAGE=ghcr.io/teableio/teable-sandbox-agent
# App runtime base image (must match the allowlist below; if blank, apps cannot deploy).
APP_RUNTIME_DEFAULT_IMAGE=ghcr.io/teableio/teable-app-runtime:latest
# Allowed app image prefixes (comma-separated; must include the default image's prefix above).
APP_RUNTIME_ALLOWED_IMAGE_PREFIXES=ghcr.io/teableio/
# npm registry mirror for app containers' dependency-install fallback (blank = official registry).
# China deployments: https://registry.npmmirror.com
#APP_RUNTIME_NPM_REGISTRY=
# Sandbox execution-plane images (execd is injected into every sandbox; egress is a per-sandbox sidecar).
# Pinned builds matched to OPENSANDBOX_SERVER_IMAGE above; upgrade them together, not independently.
# China deployments: swap the ghcr.io/teableio/ prefix for registry.cn-shenzhen.aliyuncs.com/teable/ (identical tags).
EXECD_IMAGE=ghcr.io/teableio/opensandbox-execd:v1.0.19-fix3
EGRESS_IMAGE=ghcr.io/teableio/opensandbox-egress:v1.0.12
# MinIO pinned to the platform release (matches the Kubernetes example); pin digests instead for stricter production setups.
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
# Entry proxy for the your-own-certificate TLS option (official Caddy; mirror it for air-gapped hosts and point this at the mirror).
# The automatic-certificate option builds its own image locally from Dockerfile.caddy instead and ignores this line.
CADDY_STATIC_IMAGE=caddy:2.9.1

# === Artifact store S3 / MinIO ===
S3_BUCKET=teable-app-artifacts
S3_REGION=us-east-1

# === Networks (rarely changed; read by both compose and opensandbox.toml; rename only here) ===
APP_RUNTIME_DOCKER_NETWORK=teable-appnet
SANDBOX_DOCKER_NETWORK=teable-sandbox-net

# ============================================================================
# === Teable app (all-in-one) -- enabled only with ./apply.sh server --with-app ===
# Without --with-app this whole section can be ignored. The main site takes the root domain; the console automatically yields to infra.<BASE_DOMAIN>.
# ============================================================================

# Teable app image. Docker deployments work out of the box with latest;
# to pin a version (recommended for production) run ./pin-image.sh, which resolves and writes it back here;
# for Kubernetes, paste the resolved reference into the image fields of your values.
TEABLE_IMAGE=ghcr.io/teableio/teable:latest
# Container timezone.
TIMEZONE=UTC

# --- Database / cache (leave passwords blank to auto-generate; PG publishes no host port) ---
TEABLE_DB_IMAGE=postgres:15.4
TEABLE_DB_NAME=teable
TEABLE_DB_USER=teable
TEABLE_DB_PASSWORD=
TEABLE_REDIS_IMAGE=redis:7.2.4
TEABLE_REDIS_PASSWORD=

# --- Attachment storage buckets ---
TEABLE_PUBLIC_BUCKET=teable-public
TEABLE_PRIVATE_BUCKET=teable-private

# --- Secrets (leave blank to auto-generate; the source-code defaults are public hardcoded values, so public deployments must generate per host) ---
BACKEND_STORAGE_ENCRYPTION_KEY=
BACKEND_STORAGE_ENCRYPTION_IV=
SANDBOX_JWT_SECRET=

# ============================================================================
# === Advanced (optional) -- relocate the console/site hosts. Usually untouched: leave blank to derive everything from BASE_DOMAIN ===
# Only the console/site hosts are relocatable (INFRA_HOST / TEABLE_HOST / PUBLIC_ORIGIN / the attachment endpoint below);
# the *.app. / *.sandbox. wildcards are derived from BASE_DOMAIN and not separately configurable in this version;
# for stronger isolation of untrusted content you may later move them to a separate registrable domain (Kubernetes values support this today).
# Your values win, apply.sh does not overwrite them.
# ============================================================================

# Infra console entry (default: infra.<BASE_DOMAIN> with --with-app, <BASE_DOMAIN> for infra-only).
INFRA_HOST=
# Teable main site host (default = BASE_DOMAIN root; takes effect with --with-app).
TEABLE_HOST=
# Public origin (default https://<TEABLE_HOST>).
PUBLIC_ORIGIN=
# Attachment public endpoint (defaults to the Infra host / 443 / true; buckets route by path prefix on that host).
TEABLE_MINIO_ENDPOINT_HOST=
TEABLE_MINIO_ENDPOINT_PORT=
TEABLE_MINIO_USE_SSL=

# --- Private CA (only when the entry's certificate is signed by a private/corporate CA) ---
# Absolute host path (PEM) to the CA root certificate. apply.sh mounts it into the app-side containers
# (infra-service, and the Teable app with --with-app) and into every sandbox, and points NODE_EXTRA_CA_CERTS at it,
# so every in-stack HTTPS call to your entry is trusted. The corporate root alone is enough (Node appends it to its
# built-in roots). Needs opensandbox-server >= v0.2.0-fix6. Guide: private-network.md.
# After setting or replacing it: ./apply.sh server [--with-app] then docker compose up -d (recreates what loads it).
PRIVATE_CA_FILE=
# Legacy name for the sandbox-only mount; PRIVATE_CA_FILE covers it, keep this blank.
SANDBOX_CA_CERT_FILE=
# Escape hatch for short trials only: set to 1 to disable Node TLS verification inside sandboxes.
SANDBOX_TLS_NO_VERIFY=
# Extra host files mounted into every sandbox (advanced): comma-separated host:container[:ro] entries,
# e.g. a sudoers drop-in -- see TROUBLESHOOTING.md.
SANDBOX_EXTRA_BINDS=
